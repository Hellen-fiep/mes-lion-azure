<?xml version="1.0" encoding="utf-8"?>
<!-- Azure App Service (Windows) / IIS: hospedagem ASP.NET Core e limite de upload do estado do MES (512 MB). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\MesLion.Server.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="536870912" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
